---
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-heading">
	<div class="inner">
		<div class="content">
			<p class="greeting">Hello, I'm</p>
			<h1 id="hero-heading" class="name">{site.name}</h1>
			<p class="role">{site.role}</p>
			<p class="tagline">{site.tagline}</p>
			<div class="actions">
				<a class="btn primary" href="#projects">View projects</a>
				<a class="btn" href="#contact">Get in touch</a>
			</div>
		</div>
		<img
			class="portrait"
			src={site.images.hero}
			width="480"
			height="640"
			alt={`${site.name} at a scenic overlook`}
			loading="eager"
			decoding="async"
		/>
	</div>
</section>

<style>
	.hero {
		background: linear-gradient(180deg, #d3d3d3 0%, #ffffff 100%);
		border-bottom: 2px solid #000080;
	}

	.inner {
		display: grid;
		gap: 2rem;
		align-items: center;
		max-width: 72rem;
		margin: 0 auto;
		padding: 5rem 1.5rem 4rem;
	}

	.portrait {
		width: 100%;
		max-width: 20rem;
		margin: 0 auto;
		border: 2px solid #000080;
		border-radius: 0.5rem;
		object-fit: cover;
		aspect-ratio: 3 / 4;
	}

	@media (min-width: 48rem) {
		.inner {
			grid-template-columns: 1fr auto;
			gap: 3rem;
		}

		.portrait {
			margin: 0;
			max-width: 16rem;
		}
	}

	.greeting {
		margin: 0 0 0.5rem;
		font-size: 1.125rem;
		font-weight: 600;
		color: #000080;
	}

	.name {
		margin: 0;
		font-size: clamp(2.5rem, 8vw, 4rem);
		font-weight: 800;
		line-height: 1.05;
		color: #000080;
	}

	.role {
		margin: 0.75rem 0 0;
		font-size: clamp(1.25rem, 3vw, 1.75rem);
		font-weight: 700;
		color: #1a1a1a;
	}

	.tagline {
		max-width: 36rem;
		margin: 1.25rem 0 0;
		font-size: 1.125rem;
		line-height: 1.65;
		color: #333;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 1.25rem;
		font-size: 0.9375rem;
		font-weight: 700;
		text-decoration: none;
		border: 2px solid #000080;
		border-radius: 0.25rem;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.btn.primary {
		color: #d3d3d3;
		background: #000080;
	}

	.btn.primary:hover {
		color: #000080;
		background: transparent;
	}

	.btn:not(.primary) {
		color: #000080;
		background: transparent;
	}

	.btn:not(.primary):hover {
		color: #d3d3d3;
		background: #000080;
	}
</style>
