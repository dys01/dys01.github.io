---
import SectionHeader from './SectionHeader.astro';
import { skillGroups } from '../data/site';
---

<section class="skills" id="skills" aria-labelledby="skills-heading">
	<div class="inner">
		<SectionHeader
			eyebrow="Toolbox"
			heading="Skills"
			headingId="skills-heading"
			intro="Technologies and practices I use day to day."
		/>
		<ul class="grid">
			{skillGroups.map((group) => (
				<li class="group">
					<h3 class="group-title">{group.title}</h3>
					<ul class="tags">
						{group.items.map((item) => (
							<li class="tag">{item}</li>
						))}
					</ul>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.skills {
		background: #ffffff;
	}

	.inner {
		max-width: 72rem;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.group {
		padding: 1.5rem;
		background:rgb(236, 236, 236);
		border: 2px solid #000080;
		border-radius: 0.5rem;
	}

	.group-title {
		margin: 0 0 1rem;
		font-size: 1.0625rem;
		font-weight: 800;
		color: #000080;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag {
		padding: 0.35rem 0.75rem;
		font-size: 0.8125rem;
		font-weight: 600;
		color: #d3d3d3;
		background: #000080;
		border-radius: 999px;
	}
</style>
