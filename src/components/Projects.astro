---
import ProjectCard, { type Project } from './ProjectCard.astro';
import SectionHeader from './SectionHeader.astro';

const projects: Project[] = [
	{
		title: 'Portfolio site',
		description:
			"A fast, static personal site built with Astro. Focused on clear typography and a minimal two-color palette. The site you're looking at right now!",
		tags: ['Astro', 'TypeScript', 'CSS'],
		href: 'https://dys01.github.io',
		repo: 'https://github.com/dys01/dys01.github.io',
	},
	{
		title: 'Project #2 Coming Soon!',
		description:
			'lorem ipsum dolor sit amet consectetur adipiscing elit animi cum qui vel culpa ut eum est dolore culpa facilis dolore',
		tags: [],
	},
	{
		title: 'Project #3 Coming Soon!',
		description:
			'lorem ipsum dolor sit amet consectetur adipiscing elit animi cum qui vel culpa ut eum est dolore culpa facilis dolore',
		tags: [],
	},
];
---

<section class="projects" id="projects" aria-labelledby="projects-heading">
	<SectionHeader
		eyebrow="Selected work"
		heading="Projects"
		headingId="projects-heading"
		intro="A few things I have built or contributed to!"
	/>
	<ul class="grid">
		{projects.map((project) => (
			<li class="grid-item">
				<ProjectCard project={project} />
			</li>
		))}
	</ul>
</section>

<style>
	.projects {
		width: 100%;
		max-width: 72rem;
		margin: 0 auto;
		padding: 4rem 1.5rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.grid-item {
		display: flex;
		min-height: 0;
	}
</style>
