---
export interface Project {
	title: string;
	description: string;
	tags: string[];
	href?: string;
	repo?: string;
}

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<article class="card">
	<h3 class="title">{project.title}</h3>
	<p class="description">{project.description}</p>
	<ul class="tags" aria-label="Technologies">
		{project.tags.map((tag) => (
			<li class="tag">{tag}</li>
		))}
	</ul>
	{(project.href || project.repo) && (
		<div class="actions">
			{project.href && (
				<a class="link primary" href={project.href} target="_blank" rel="noopener noreferrer">
					View project
				</a>
			)}
			{project.repo && (
				<a class="link" href={project.repo} target="_blank" rel="noopener noreferrer">
					Source
				</a>
			)}
		</div>
	)}
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		height: 100%;
		padding: 1.5rem;
		background:rgb(231, 231, 231);
		border: 2px solid #000080;
		border-radius: 0.5rem;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 24px rgb(0 0 128 / 0.2);
	}

	.title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
		color: #000080;
		line-height: 1.3;
	}

	.description {
		margin: 0;
		flex: 1;
		font-size: 0.95rem;
		line-height: 1.6;
		color: #1a1a1a;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag {
		padding: 0.25rem 0.625rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: #d3d3d3;
		background: #000080;
		border-radius: 999px;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding-top: 0.25rem;
	}

	.link {
		font-size: 0.875rem;
		font-weight: 600;
		color: #000080;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: border-color 0.15s ease;
	}

	.link:hover {
		border-bottom-color: #000080;
	}

	.link.primary {
		padding: 0.5rem 1rem;
		color: #d3d3d3;
		background: #000080;
		border: 2px solid #000080;
		border-radius: 0.25rem;
	}

	.link.primary:hover {
		color: #000080;
		background: transparent;
		border-bottom-color: #000080;
	}
</style>
